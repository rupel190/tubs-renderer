{
	"name": "tubs-renderer",
	"version": "0.1.0",
	"description": "Render TUBS rhythm grids from tubs code blocks in Obsidian, with click-to-play Tone.js audio.",
	"main": "main.js",
	"scripts": {
		"dev": "bun esbuild.config.mjs",
		"build": "bunx tsc -noEmit -skipLibCheck && bun esbuild.config.mjs production",
		"version": "bun version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"tubs",
		"rhythm",
		"notation",
		"drums"
	],
	"author": "Rupel Rupelsson",
	"license": "MIT",
	"devDependencies": {
		"@tsconfig/svelte": "^5.0.4",
		"@types/node": "^20.12.2",
		"builtin-modules": "3.3.0",
		"esbuild": "^0.20.2",
		"esbuild-svelte": "^0.9.3",
		"obsidian": "^1.5.7-1",
		"svelte": "^5.0.0",
		"svelte-preprocess": "^6.0.0",
		"tslib": "^2.6.2",
		"typescript": "^5.4.5"
	},
	"dependencies": {
		"tone": "14.8.49"
	}
}
